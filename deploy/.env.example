# Copia a deploy/.env (chmod 600). No subir secretos al repositorio.
SOR_ORIGIN=https://panel.tu-dominio.com
# Generar con: openssl rand -base64 32
SOR_SECRET_KEY=
SOR_IMAGE=sor-hosting:local
SOR_PANEL_PORT=8080
SOR_DATA_DIR=/var/lib/sor-hosting/panel
# URL accesible DESDE el contenedor de API; localhost no es el host.
SOR_PROMETHEUS_URL=
SOR_PROMETHEUS_INSTANCE=
SOR_FILESYSTEM=/
